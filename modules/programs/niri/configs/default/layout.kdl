// https://niri-wm.github.io/niri/Configuration:-Layout

layout {
    gaps 10

    struts {
        top 0
        bottom 0
        left 8
        right 8
    }

    center-focused-column "never"
    always-center-single-column

    preset-column-widths {
        proportion 0.20
        proportion 0.30
        proportion 0.40
        proportion 0.50
        proportion 0.60
        proportion 0.70
        proportion 0.80
        proportion 1.00
    }

    // preset-window-heights { }

    default-column-width { } // let each window decide its initial width
    // default-column-width { proportion 0.96; }

    focus-ring {
        // off
        width 2
        active-color "#82aaff"
        // active-gradient from="#33ccffee" to="#00ff99ee" angle=45
    }

    border {
        off
    }

    shadow {
        off
        // draw-behind-window true
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }

    // background-color "#ff0000"
}
