/*
  https://niri-wm.github.io/niri/Configuration%3A-Key-Bindings.html

  To find the XKB name for a particular key, use `wev`.

  Most actions invoked here can also be called programmatically with
  `niri msg action do-something`.
*/

binds {
    Mod+Shift+e repeat=false { quit; } // exit niri

    Mod+Shift+p repeat=false { power-off-monitors; }

    Mod+o repeat=false { toggle-overview; }

    Mod+w repeat=false { close-window; }

    Mod+f repeat=false { maximize-window-to-edges; }
    Mod+Shift+f repeat=false { fullscreen-window; }
    Mod+z repeat=false { toggle-windowed-fullscreen; } // hide tabs (zen mode)

    Mod+Period repeat=false { switch-preset-window-width; }
    Mod+Comma repeat=false { switch-preset-window-width-back; }
    Mod+m repeat=false repeat=false { maximize-column; }
    Mod+Shift+m repeat=false { expand-column-to-available-width; }

    Mod+c repeat=false { center-column; }

    Mod+Left { set-column-width "-1%"; }
    Mod+Right { set-column-width "+1%"; }
    Mod+Down { set-window-height "-1%"; }
    Mod+Up { set-window-height "+1%"; }

    Mod+t repeat=false { toggle-window-floating; } // toggle tiling
    Mod+slash repeat=false { switch-focus-between-floating-and-tiling; }

    Mod+h cooldown-ms=25 { focus-column-left; }
    Mod+l cooldown-ms=25 { focus-column-right; }
    Mod+k cooldown-ms=25 { focus-window-or-workspace-up; }
    Mod+j cooldown-ms=25 { focus-window-or-workspace-down; }

    Mod+WheelScrollRight cooldown-ms=150 { focus-column-left; }
    Mod+WheelScrollLeft cooldown-ms=150 { focus-column-right; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-window-or-workspace-up; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-window-or-workspace-down; }

    // see bottom
    Mod+b repeat=false { focus-window-previous; }

    Mod+Shift+h cooldown-ms=25 { move-column-left; }
    Mod+Shift+l cooldown-ms=25 { move-column-right; }
    Mod+Shift+j cooldown-ms=25 { move-column-to-workspace-down; }
    Mod+Shift+k cooldown-ms=25 { move-column-to-workspace-up; }

    Mod+Shift+left cooldown-ms=25 { consume-or-expel-window-left; }
    Mod+Shift+right cooldown-ms=25 { consume-or-expel-window-right; }
    Mod+Shift+down cooldown-ms=25 { move-window-down-or-to-workspace-down; }
    Mod+Shift+up cooldown-ms=25 { move-window-up-or-to-workspace-up; }

    Mod+1 repeat=false { focus-workspace 1; }
    Mod+2 repeat=false { focus-workspace 2; }
    Mod+3 repeat=false { focus-workspace 3; }
    Mod+4 repeat=false { focus-workspace 4; }
    Mod+5 repeat=false { focus-workspace 5; }
    Mod+6 repeat=false { focus-workspace 6; }
    Mod+7 repeat=false { focus-workspace 7; }
    Mod+8 repeat=false { focus-workspace 8; }
    Mod+9 repeat=false { focus-workspace 9; }

    Mod+Shift+1 repeat=false { move-column-to-workspace 1; }
    Mod+Shift+2 repeat=false { move-column-to-workspace 2; }
    Mod+Shift+3 repeat=false { move-column-to-workspace 3; }
    Mod+Shift+4 repeat=false { move-column-to-workspace 4; }
    Mod+Shift+5 repeat=false { move-column-to-workspace 5; }
    Mod+Shift+6 repeat=false { move-column-to-workspace 6; }
    Mod+Shift+7 repeat=false { move-column-to-workspace 7; }
    Mod+Shift+8 repeat=false { move-column-to-workspace 8; }
    Mod+Shift+9 repeat=false { move-column-to-workspace 9; }

    Mod+Prior repeat=false { move-workspace-up; }
    Mod+Next repeat=false { move-workspace-down; }

    Mod+Ctrl+h repeat=false { focus-monitor-left; }
    Mod+Ctrl+l repeat=false { focus-monitor-right; }
    Mod+Ctrl+k repeat=false { focus-monitor-up; }
    Mod+Ctrl+j repeat=false { focus-monitor-down; }

    Mod+Ctrl+Shift+h repeat=false { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+l repeat=false { move-column-to-monitor-right; }
    Mod+Ctrl+Shift+k repeat=false { move-column-to-monitor-up; }
    Mod+Ctrl+Shift+j repeat=false { move-column-to-monitor-down; }

    Mod+Ctrl+Alt+h repeat=false { move-workspace-to-monitor-left; }
    Mod+Ctrl+Alt+l repeat=false { move-workspace-to-monitor-right; }
    Mod+Ctrl+Alt+k repeat=false { move-workspace-to-monitor-up; }
    Mod+Ctrl+Alt+j repeat=false { move-workspace-to-monitor-down; }

    // -------------------------------------------------------------------------

    Mod+Space { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+Shift+space { spawn-sh "noctalia msg bar-toggle"; }

    Mod+Ctrl+a { spawn-sh "noctalia msg screenshot-annotate"; }
    Mod+Ctrl+s { spawn-sh "noctalia msg screenshot-region"; }

    Mod+Ctrl+p { spawn-sh "noctalia msg panel-toggle control-center power"; }
    Mod+Ctrl+n { spawn-sh "noctalia msg panel-toggle control-center network"; }
    Mod+Ctrl+b { spawn-sh "noctalia msg panel-toggle control-center bluetooth"; }
    Mod+Ctrl+c { spawn-sh "noctalia msg panel-toggle clipboard"; }

    Mod+Escape { spawn-sh "noctalia msg session lock"; }
    Mod+Shift+Escape { spawn-sh "noctalia msg session lock-and-suspend"; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }

    // -- these don't work on the macbook
    // XF86MonBrightnessUp { spawn-sh "noctalia msg brightness-up"; }
    // XF86MonBrightnessDown { spawn-sh "noctalia msg brightness-down"; }
    //
    // -- brightnessctl + noctalia's on-screen-display feedback
    // XF86MonBrightnessUp allow-when-locked=true { spawn-sh "brightnessctl --class=backlight set +10% && noctalia msg brightness-osd $(brightnessctl --class=backlight -m | cut -d',' -f4 | tr -d '%')" }
    // XF86MonBrightnessDown allow-when-locked=true { spawn-sh "brightnessctl --class=backlight set 10%- && noctalia msg brightness-osd $(brightnessctl --class=backlight -m | cut -d',' -f4 | tr -d '%')" }
    //
    // -- brightnessctl without on-screen-display feedback
    XF86MonBrightnessUp allow-when-locked=true { spawn-sh "brightnessctl --class=backlight set +10%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "brightnessctl --class=backlight set 10%-"; }

    XF86KbdBrightnessUp allow-when-locked=true { spawn-sh "noctalia msg keyboard-backlight-set 100"; }
    XF86KbdBrightnessDown allow-when-locked=true { spawn-sh "noctalia msg keyboard-backlight-set 0"; }

    // XF86AudioPlay allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    // XF86AudioStop allow-when-locked=true { spawn-sh "playerctl stop"; }
    // XF86AudioPrev allow-when-locked=true { spawn-sh "playerctl previous"; }
    // XF86AudioNext allow-when-locked=true { spawn-sh "playerctl next"; }
    XF86AudioPlay allow-when-locked=true { spawn-sh "noctalia msg media toggle"; }
    XF86AudioPrev allow-when-locked=true { spawn-sh "noctalia msg media previous"; }
    XF86AudioNext allow-when-locked=true { spawn-sh "noctalia msg media next"; }

    Mod+return repeat=false hotkey-overlay-title="Open a Terminal: foot" { spawn "foot"; }

    // (most media keys execute noctalia commands, see that file)

    // Media/F-keys (toggle between then with `fn+Esc`)
    // XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05+ -l 1.0"; } // `-l 1.0` limits the volume to 100%
    // XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05-"; }
    // XF86AudioMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    // XF86AudioMicMute allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    // XF86AudioPlay allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    // XF86AudioStop allow-when-locked=true { spawn-sh "playerctl stop"; }
    // XF86AudioPrev allow-when-locked=true { spawn-sh "playerctl previous"; }
    // XF86AudioNext allow-when-locked=true { spawn-sh "playerctl next"; }

    Print repeat=false { screenshot; }
    Alt+Print repeat=false { screenshot-window; }
    Ctrl+Print repeat=false { screenshot-screen; }

    // Applications such as remote-desktop clients and software KVM switches
    // may request that niri stops processing the keyboard shortcuts defined
    // here so they may, for example, forward the key presses as-is to a remote
    // machine.
    // It's a good idea to bind an escape hatch to toggle the inhibitor, so a
    // buggy application can't hold your session hostage.
    // The allow-inhibiting=false property can be applied to other binds as
    // well, which ensures niri always processes them, even when an inhibitor
    // is active.
    Mod+Alt+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
}
