// No client side decorations
prefer-no-csd

cursor {
    xcursor-theme "Bibata-Modern-Ice"
    // xcursor-theme "breeze_cursors"
    xcursor-size 22
    hide-when-typing
    // hide-after-inactive-ms 1000
}

hotkey-overlay {
    skip-at-startup
}

blur {
    off
    // passes 3
    // offset 3.0
    // noise 0.02
    // saturation 1.5
}

// https://niri-wm.github.io/niri/Configuration%3A-Gestures.html
gestures {
    hot-corners {
        // off
        top-left
    }
}

recent-windows {
    debounce-ms 750 // briefly focused windows are not added to the list
    open-delay-ms 0 // open inmediately
}

// https://niri-wm.github.io/niri/Configuration%3A-Animations.html
animations {
    // off
    workspace-switch {
        off
    }
    window-open {
        duration-ms 150
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 150
        curve "ease-out-quad"
    }
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    config-notification-open-close {
        spring damping-ratio=0.6 stiffness=1000 epsilon=0.001
    }
    exit-confirmation-open-close {
        spring damping-ratio=0.6 stiffness=500 epsilon=0.01
    }
    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }
    overview-open-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }
    recent-windows-close {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.001
    }
}
